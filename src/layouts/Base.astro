---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Art from '../components/Art.astro';
import { t, languages, route, url, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title?: string;
  /** Carrega todas as fontes candidatas (página de estilo). */
  allFonts?: boolean;
  noindex?: boolean;
}
const { lang, routeKey, title, allFonts = false, noindex = false } = Astro.props;
const d = t(lang);
const pageTitle = title ? `${title} · ${d.meta.title}` : d.meta.title;
const ogImage = new URL(url('/og.jpg'), Astro.site).href;
const scripts = allFonts
  ? ['Mrs+Saint+Delafield', 'Herr+Von+Muellerhoff', 'Italianno', 'Parisienne', 'Pinyon+Script']
  : ['Mrs+Saint+Delafield'];
const fontsHref = `https://fonts.googleapis.com/css2?${scripts.map((f) => `family=${f}`).join('&')}&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap`;
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={d.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fffcd6" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(route(routeKey, l), Astro.site).href} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip</a>
    <Nav lang={lang} routeKey={routeKey} />
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="divider"><Art name="concha" style="width:56px" /></div>
      <p class="script footer__names">Luiza &amp; Bernardo</p>
      <p class="caps">20 · 03 · 2027 — Santa Teresa, Rio de Janeiro</p>
      <p class="footer__made">{d.footer.made}</p>
    </footer>
    <script>
      // Revela elementos .reveal ao entrarem na tela
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .footer {
    text-align: center;
    padding: 64px var(--gutter) 48px;
    border-top: 1px solid var(--ink-faint);
  }
  .footer__names { font-size: var(--step-script); margin: 24px 0 12px; }
  .footer__made { color: var(--ink-soft); font-style: italic; margin-top: 16px; }
</style>
