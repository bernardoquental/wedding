---
import Base from '../layouts/Base.astro';
import Art from './Art.astro';
import SectionTitle from './SectionTitle.astro';
import { gifts, categories } from '../data/gifts';
import { config } from '../config';
import { t, route, formatBRL, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const g = d.gifts;
const usedCats = [...new Set(gifts.map((x) => x.category))];
const strings = {
  copy: g.copy, copied: g.copied, send: g.send, thanks: g.thanks,
  error: d.rsvp.error, nameError: d.rsvp.fullNameError, demo: d.rsvp.demo,
};
const pix = {
  key: config.pix.key, merchantName: config.pix.merchantName, merchantCity: config.pix.merchantCity,
};
---
<Base lang={lang} routeKey="gifts" title={g.title}>
  <section class="section gifts-head">
    <div class="wrap center">
      <Art name="concha" class="gifts-head__shell" />
      <SectionTitle text={g.title} tag="h1" />
      <p class="narrow">{g.intro}</p>
    </div>
  </section>

  <section class="section gifts-list" aria-label={g.title}>
    <div class="wrap">
      <div class="filters" role="group">
        <button class="btn btn--small btn--solid" type="button" data-filter="">{g.filterAll}</button>
        {usedCats.map((c) => <button class="btn btn--small" type="button" data-filter={c}>{categories[c]?.[lang] ?? c}</button>)}
      </div>

      <ul class="grid">
        {gifts.map((gift) => (
          <li class="gift reveal" data-category={gift.category}>
            <div class="gift__art"><Art name="concha" /></div>
            <h2 class="gift__name">{gift.name[lang]}</h2>
            <p class="gift__desc">{gift.description[lang]}</p>
            <p class="gift__price">{formatBRL(gift.price, lang)}</p>
            <button class="btn btn--small" type="button"
              data-gift={gift.id} data-name={gift.name[lang]} data-price={gift.price} data-stripe={gift.stripeUrl ?? ''}>
              {g.give}
            </button>
          </li>
        ))}
        <li class="gift gift--custom reveal" data-category="">
          <div class="gift__art"><Art name="ramo-esquerdo" style="width:36px" /></div>
          <h2 class="gift__name">{g.custom}</h2>
          <p class="gift__desc">{g.customText}</p>
          <p class="gift__price">R$ —</p>
          <button class="btn btn--small" type="button" data-gift="valor-livre" data-name={g.custom} data-price="0" data-stripe={config.stripeOpenAmountUrl}>
            {g.give}
          </button>
        </li>
      </ul>
    </div>
  </section>

  <div class="thanks wrap">
    <Art name="querubim-esquerdo" class="thanks__cherub" />
    <p class="script thanks__text">Obrigado · Thank you · Gracias</p>
    <Art name="querubim-direito" class="thanks__cherub" />
  </div>

  <dialog class="pix" aria-labelledby="pix-title" data-strings={JSON.stringify(strings)} data-pix={JSON.stringify(pix)}>
    <form method="dialog" class="pix__close-form"><button class="pix__close" aria-label={d.nav.close}>×</button></form>
    <p class="caps pix__gift"></p>
    <h2 id="pix-title" class="script pix__title">{g.pixTitle}</h2>

    <label class="field pix__amount">
      <span>{g.amount} (R$)</span>
      <input class="input" type="number" min="1" step="1" inputmode="numeric" name="amount" />
    </label>
    <div class="pix__qr" aria-hidden="true"></div>
    <p class="pix__steps">{g.pixSteps}</p>
    <textarea class="input pix__code" readonly rows="3" aria-label="Pix copia e cola"></textarea>
    <button class="btn btn--solid pix__copy" type="button">{g.copy}</button>
    <p class="pix__card" hidden>
      <a class="pix__card-link" target="_blank" rel="noopener">{g.card}</a><br />
      <small>{g.cardNote}</small>
    </p>

    <form class="pix__msg" novalidate>
      <h3 class="caps">{g.messageTitle}</h3>
      <p>{g.messageIntro}</p>
      <label class="field"><span>{g.name}</span><input class="input" name="fullName" autocomplete="name" /></label>
      <small class="error pix__name-err" hidden></small>
      <label class="field"><span>{g.message}</span><textarea class="input" name="message" rows="3"></textarea></label>
      <label class="visually-hidden" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
      <button class="btn" type="submit">{g.send}</button>
      <div class="pix__status" role="status" aria-live="polite"></div>
    </form>
    <p class="center"><a href={route('home', lang)}>{g.back}</a></p>
  </dialog>
</Base>

<script>
  import QRCode from 'qrcode';
  import { pixPayload } from '../lib/pix';
  import { send } from '../lib/api';
  import { isFullName } from '../lib/validate';

  const dialog = document.querySelector<HTMLDialogElement>('dialog.pix')!;
  const s = JSON.parse(dialog.dataset.strings!);
  const pix = JSON.parse(dialog.dataset.pix!);
  const $ = <T extends Element = HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
  const amountField = $('.pix__amount');
  const amountInput = $<HTMLInputElement>('[name=amount]');
  const code = $<HTMLTextAreaElement>('.pix__code');
  const copyBtn = $<HTMLButtonElement>('.pix__copy');
  let current = { id: '', name: '', price: 0 };

  async function render() {
    const amount = current.price || Number(amountInput.value) || 0;
    const payload = pixPayload({ ...pix, amount, txid: current.id.replace(/[^A-Za-z0-9]/g, '').slice(0, 25) });
    code.value = payload;
    $('.pix__qr').innerHTML = await QRCode.toString(payload, {
      type: 'svg', margin: 1, errorCorrectionLevel: 'M',
      color: { dark: '#36418a', light: '#fffef0' },
    });
  }

  // Filtros
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filterBtns.forEach((b) =>
    b.addEventListener('click', () => {
      filterBtns.forEach((x) => x.classList.toggle('btn--solid', x === b));
      document.querySelectorAll<HTMLElement>('.gift').forEach((li) => {
        li.hidden = !!b.dataset.filter && li.dataset.category !== b.dataset.filter && !li.classList.contains('gift--custom');
      });
    }),
  );

  // Abrir modal
  document.querySelectorAll<HTMLButtonElement>('[data-gift]').forEach((b) =>
    b.addEventListener('click', async () => {
      current = { id: b.dataset.gift!, name: b.dataset.name!, price: Number(b.dataset.price) };
      $('.pix__gift').textContent = current.price
        ? `${current.name} · ${b.closest('.gift')!.querySelector('.gift__price')!.textContent}`
        : current.name;
      amountField.hidden = current.price > 0;
      amountInput.value = '';
      const stripe = b.dataset.stripe;
      $('.pix__card').hidden = !stripe;
      if (stripe) $<HTMLAnchorElement>('.pix__card-link').href = stripe;
      $('.pix__status').innerHTML = '';
      $<HTMLFormElement>('.pix__msg').querySelectorAll<HTMLElement>('.field, button').forEach((n) => (n.hidden = false));
      copyBtn.textContent = s.copy;
      await render();
      dialog.showModal();
    }),
  );
  amountInput.addEventListener('input', render);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(code.value);
    } catch {
      code.select();
      document.execCommand('copy');
    }
    copyBtn.textContent = s.copied;
    setTimeout(() => (copyBtn.textContent = s.copy), 2500);
  });

  // Recado pós-pagamento
  const msgForm = $<HTMLFormElement>('.pix__msg');
  msgForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(msgForm);
    const fullName = String(fd.get('fullName') ?? '').trim();
    const err = $('.pix__name-err');
    const ok = isFullName(fullName);
    err.hidden = ok;
    err.textContent = ok ? '' : s.nameError;
    msgForm.querySelector('[name=fullName]')!.setAttribute('aria-invalid', String(!ok));
    if (!ok) return;
    const btn = msgForm.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true;
    try {
      const res = await send('gift_message', {
        fullName,
        message: String(fd.get('message') ?? ''),
        giftId: current.id,
        giftName: current.name,
        amount: current.price || Number(amountInput.value) || 0,
        website: String(fd.get('website') ?? ''),
      });
      if (!res.ok) throw new Error(res.error);
      msgForm.querySelectorAll<HTMLElement>('.field, button').forEach((n) => (n.hidden = true));
      $('.pix__status').innerHTML = `<p class="notice">${s.thanks}</p>` + (res.demo ? `<p class="notice notice--soft">${s.demo}</p>` : '');
      msgForm.reset();
    } catch (e) {
      console.error(e);
      $('.pix__status').innerHTML = `<p class="error">${s.error}</p>`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .gifts-head { padding-bottom: 32px; }
  .gifts-head :global(.gifts-head__shell) { width: 120px; margin: 0 auto 24px; }
  .gifts-list { padding-top: 0; }
  .filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 40px; }

  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px;
  }
  .gift {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 32px 24px 28px; background: var(--paper);
    border: var(--line) solid var(--ink-faint); border-radius: var(--radius);
    transition: border-color 0.2s, translate 0.2s;
  }
  .gift:hover { border-color: var(--ink); translate: 0 -2px; }
  .gift__art { height: 48px; display: grid; place-items: center; margin-bottom: 18px; }
  .gift__art :global(.art) { width: 56px; }
  .gift__name { font-size: var(--step-1); line-height: 1.2; margin-bottom: 8px; }
  .gift__desc { color: var(--ink-soft); font-size: 1rem; flex: 1; }
  .gift__price { font-size: var(--step-2); margin: 4px 0 18px; font-variant-numeric: lining-nums; }

  .thanks { display: flex; align-items: center; justify-content: center; gap: clamp(8px, 3vw, 40px); padding-bottom: 64px; }
  .thanks :global(.thanks__cherub) { width: clamp(90px, 18vw, 200px); }
  .thanks__text { font-size: clamp(1.8rem, 1.2rem + 2.5vw, 3.4rem); text-align: center; }

  .pix {
    width: min(100% - 32px, 460px); max-height: calc(100dvh - 32px);
    padding: 36px 28px 24px; border: var(--line) solid var(--ink); border-radius: 8px;
    background: var(--cream); color: var(--ink); text-align: center;
  }
  .pix::backdrop { background: color-mix(in srgb, var(--ink-strong) 45%, transparent); backdrop-filter: blur(2px); }
  .pix__close-form { position: absolute; top: 8px; right: 10px; margin: 0; }
  .pix__close { background: none; border: 0; font-size: 2rem; color: var(--ink); cursor: pointer; line-height: 1; padding: 6px 10px; }
  .pix__gift { margin: 0 0 14px; }
  .pix__title { font-size: 3.4rem; margin-bottom: 16px; }
  .pix__amount { text-align: left; }
  .pix__qr { width: 220px; margin: 0 auto 16px; padding: 10px; border: 1px solid var(--ink-faint); background: var(--paper); }
  .pix__steps { font-size: 1rem; color: var(--ink-soft); }
  .pix__code { font-family: ui-monospace, monospace; font-size: 0.78rem; word-break: break-all; margin-bottom: 12px; min-height: 0; resize: none; }
  .pix__copy { width: 100%; }
  .pix__card { margin: 16px 0 0; }
  .pix__card small { color: var(--ink-soft); }
  .pix__msg { text-align: left; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--ink-faint); }
  .pix__msg h3, .pix__msg > p { text-align: center; }
  .pix__msg .btn { width: 100%; }
  .pix__status { display: grid; gap: 10px; }
</style>
