---
/**
 * Página inicial, na estrutura do design system:
 * Hero → História → Evento → Programação → Hospedagem → Perguntas → painel do RSVP → formulário → presentes.
 */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Art from './Art.astro';
import TituloSecao from './TituloSecao.astro';
import CartaoEvento from './CartaoEvento.astro';
import BarraAzulejo from './BarraAzulejo.astro';
import Ornamento from './Ornamento.astro';
import RSVPForm from './RSVPForm.astro';
import { config } from '../config';
import { t, route, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const ev = d.events;
---
<Base lang={lang} routeKey="home">
  <Hero lang={lang} />
  <BarraAzulejo fina />

  <section class="secao" id="historia" aria-labelledby="h-historia">
    <TituloSecao id="h-historia" kicker={d.story.kicker} text={d.story.title} lead={d.story.lead} />
    <div class="narrow historia reveal">
      {d.story.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="secao secao--esmalte" id="casamento" aria-labelledby="h-casamento">
    <TituloSecao id="h-casamento" kicker={ev.kicker} text={ev.title} lead={ev.lead} />
    <div class="wrap cartoes cartoes--dois">
      <CartaoEvento {...ev.ceremony} action={{ href: config.events.ceremony.mapsUrl, label: ev.map }} />
      <CartaoEvento {...ev.reception} action={{ href: config.events.reception.mapsUrl, label: ev.map }} />
    </div>
  </section>

  <section class="secao" id="programacao" aria-labelledby="h-programacao">
    <TituloSecao id="h-programacao" kicker={d.schedule.kicker} text={d.schedule.title} lead={d.schedule.lead} />
    <ol class="lb-programa reveal">
      {d.schedule.items.map((it) => (
        <li>
          <span class="lb-programa__hora">{it.time}</span>
          <h3 class="lb-programa__titulo">{it.title}</h3>
          <p class="lb-programa__texto">{it.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="secao secao--esmalte" id="hospedagem" aria-labelledby="h-hospedagem">
    <TituloSecao id="h-hospedagem" kicker={d.travel.kicker} text={d.travel.title} />
    <div class="wrap cartoes">
      {d.travel.items.map((it) => <CartaoEvento meta={it.meta} title={it.title} text={it.text} />)}
    </div>
  </section>

  <section class="secao" id="perguntas" aria-labelledby="h-perguntas">
    <TituloSecao id="h-perguntas" kicker={d.faq.kicker} text={d.faq.title} />
    <div class="lb-perguntas reveal">
      {d.faq.items.map((it, i) => (
        <details open={i === 0}>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="secao rsvp-chamada" aria-labelledby="h-chamada">
    <div class="lb-painel lb-juntas reveal">
      <div class="lb-painel__conteudo">
        <p class="lb-titulo__sobre">{d.rsvp.panelKicker}</p>
        <h2 id="h-chamada" class="lb-titulo__texto rsvp-chamada__titulo">{d.rsvp.panelTitle}</h2>
        <Art name="concha" class="rsvp-chamada__concha" />
        <a class="lb-btn lb-btn--primario" href="#rsvp">{d.hero.cta}</a>
      </div>
    </div>
  </section>

  <section class="secao rsvp" id="rsvp" aria-labelledby="h-rsvp">
    <TituloSecao id="h-rsvp" kicker={d.rsvp.kicker} text={d.rsvp.title} lead={d.rsvp.intro} />
    <RSVPForm lang={lang} />
  </section>

  <section class="secao secao--esmalte presentes-chamada" aria-labelledby="h-presentes">
    <div class="narrow center reveal">
      <Ornamento />
      <p class="lb-titulo__sobre presentes-chamada__sobre">{d.gifts.kicker}</p>
      <h2 id="h-presentes" class="lb-titulo__texto">{d.gifts.title}</h2>
      <p class="lb-titulo__lead presentes-chamada__lead">{d.gifts.intro}</p>
      <a class="lb-btn lb-btn--secundario" href={route('gifts', lang)}>{d.gifts.teaserCta}</a>
    </div>
  </section>
</Base>

<style>
  .historia { font: var(--text-corpo); text-align: center; max-width: 560px; }

  .cartoes {
    display: grid; gap: var(--spacing-l); justify-content: center;
    grid-template-columns: repeat(auto-fit, minmax(240px, 300px));
  }
  .cartoes--dois { grid-template-columns: repeat(auto-fit, minmax(260px, 340px)); }

  .rsvp-chamada { padding-bottom: 0; }
  .rsvp-chamada .lb-painel { width: min(100% - 2 * var(--spacing-m), 640px); margin-inline: auto; }
  .rsvp-chamada__titulo { font-size: clamp(34px, 6vw, 44px); }
  .rsvp-chamada :global(.rsvp-chamada__concha) { width: 48px; color: var(--cobalto); }
  @media (max-width: 520px) {
    .rsvp-chamada .lb-painel { padding: var(--spacing-3xl) var(--spacing-m) var(--spacing-xl); }
  }

  .presentes-chamada__sobre { margin: var(--spacing-l) 0 var(--spacing-xsm); }
  .presentes-chamada__lead { margin: var(--spacing-m) auto var(--spacing-xl); }
</style>
