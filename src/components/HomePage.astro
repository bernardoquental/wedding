---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Art from './Art.astro';
import SectionTitle from './SectionTitle.astro';
import RSVPForm from './RSVPForm.astro';
import { config } from '../config';
import { t, route, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} routeKey="home">
  <Hero lang={lang} />

  <section class="section" id="historia" aria-labelledby="h-story">
    <SectionTitle id="h-story" text={d.story.title} />
    <div class="narrow story reveal">
      {d.story.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section" id="programacao" aria-labelledby="h-schedule">
    <SectionTitle id="h-schedule" text={d.schedule.title} />
    <ol class="narrow timeline">
      {d.schedule.items.map((it) => (
        <li class="reveal">
          <span class="timeline__time caps">{it.time}</span>
          <div>
            <h3 class="timeline__title">{it.title}</h3>
            <p>{it.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="local" aria-labelledby="h-venue">
    <SectionTitle id="h-venue" text={d.venue.title} />
    <div class="venue wrap">
      <Art name="ramo-esquerdo" class="venue__branch" />
      <div class="venue__text reveal">
        <Art name="lettering-local" class="venue__lettering" label="Santa Teresa, Rio de Janeiro" />
        <p>{d.venue.text}</p>
        <a class="btn" href={config.venue.mapsUrl} target="_blank" rel="noopener">{d.venue.map}</a>
      </div>
      <Art name="ramo-direito" class="venue__branch" />
    </div>
  </section>

  <section class="section" id="traje" aria-labelledby="h-dress">
    <SectionTitle id="h-dress" text={d.dressCode.title} />
    <div class="narrow center reveal">
      <p class="caps">{d.dressCode.name}</p>
      <p>{d.dressCode.text}</p>
    </div>
  </section>

  <section class="section" id="hospedagem" aria-labelledby="h-travel">
    <SectionTitle id="h-travel" text={d.travel.title} />
    <div class="wrap cards">
      {d.travel.items.map((it) => (
        <article class="card reveal">
          <h3 class="caps">{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="duvidas" aria-labelledby="h-faq">
    <SectionTitle id="h-faq" text={d.faq.title} />
    <div class="narrow faq">
      {d.faq.items.map((it) => (
        <details class="reveal">
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section rsvp-section" id="rsvp" aria-labelledby="h-rsvp">
    <SectionTitle id="h-rsvp" text={d.rsvp.title} />
    <p class="narrow center rsvp-intro">{d.rsvp.intro}</p>
    <RSVPForm lang={lang} />
  </section>

  <section class="section gifts-teaser" aria-labelledby="h-gifts">
    <div class="narrow center reveal">
      <div class="divider"><Art name="concha" /></div>
      <h2 id="h-gifts" class="script gifts-teaser__title">{d.gifts.title}</h2>
      <p>{d.gifts.intro}</p>
      <a class="btn btn--solid" href={route('gifts', lang)}>{d.nav.gifts}</a>
    </div>
  </section>
</Base>

<style>
  .story { font-size: var(--step-1); text-align: center; }

  .timeline { list-style: none; padding: 0; margin-block: 0; }
  .timeline li {
    display: grid; grid-template-columns: 7.5rem 1fr; gap: 24px;
    padding: 22px 0; border-bottom: 1px solid var(--ink-faint);
  }
  .timeline li:last-child { border-bottom: 0; }
  .timeline__time { padding-top: 0.45em; }
  .timeline__title { font-size: var(--step-2); line-height: 1.1; margin-bottom: 4px; }
  .timeline p { margin: 0; color: var(--ink-soft); }
  @media (max-width: 520px) { .timeline li { grid-template-columns: 1fr; gap: 4px; } }

  .venue { display: grid; grid-template-columns: 1fr minmax(0, 520px) 1fr; align-items: center; gap: 24px; }
  .venue__text { text-align: center; }
  .venue :global(.venue__lettering) { width: min(100%, 340px); margin: 0 auto 28px; }
  .venue :global(.venue__branch) { width: 90px; justify-self: center; opacity: 0.9; }
  @media (max-width: 700px) {
    .venue { grid-template-columns: 1fr; }
    .venue :global(.venue__branch) { display: none; }
  }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .card {
    padding: 28px 24px; border: var(--line) solid var(--ink-faint); border-radius: var(--radius);
    background: var(--paper); text-align: center;
  }
  .card h3 { margin-bottom: 12px; }
  .card p { margin: 0; }

  .faq details { border-bottom: 1px solid var(--ink-faint); }
  .faq summary {
    list-style: none; cursor: pointer; padding: 18px 36px 18px 0; position: relative;
    font-size: var(--step-1); font-weight: 600;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; position: absolute; right: 4px; top: 50%; translate: 0 -50%;
    font-size: 1.6em; font-weight: 400; transition: rotate 0.2s;
  }
  .faq details[open] summary::after { rotate: 45deg; }
  .faq details p { padding-bottom: 12px; }

  .rsvp-intro { margin-bottom: 40px; }
  .gifts-teaser__title { font-size: var(--step-script); margin: 24px 0 20px; }
  .gifts-teaser .divider :global(.art) { width: 64px; }
</style>
