---
/**
 * FitaTitulo (DS): a fita do convite com um texto curto em arco.
 * A fita é o vetor faixa.svg (equivalente a ribbon-blank.png), embutido e pintado em cobalto,
 * com o texto em script sobre um arco (textPath), como no DS.
 */
import { readFileSync } from 'node:fs';

interface Props { text: string; tag?: 'h1' | 'h2' }
const { text, tag: Tag = 'h1' } = Astro.props;
const svg = readFileSync('public/art/faixa.svg', 'utf8');
const [, , w, h] = svg.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number);
const ribbon = svg.match(/<g[\s\S]*<\/g>/)![0];
// Arco que acompanha a faixa central do vetor (o arco do DS foi medido na ribbon-blank.png, de outro enquadramento)
const arc = `M${0.16 * w} ${0.62 * h} Q${0.5 * w} ${0.1 * h} ${0.84 * w} ${0.62 * h}`;
const id = `arco-${Math.random().toString(36).slice(2, 8)}`;
---
<Tag class="lb-fita">
  <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={text}>
    <Fragment set:html={ribbon} />
    <path id={id} d={arc} fill="none" />
    <text font-size={0.28 * h} text-anchor="middle"><textPath href={`#${id}`} startOffset="50%">{text}</textPath></text>
  </svg>
</Tag>

<style>
  .lb-fita { color: var(--cobalto); font-weight: 400; }
  .lb-fita :global(svg g) { fill: currentColor; }
</style>
