---
/** Título de seção em caligrafia dentro da faixa do save the date. */
import Art from './Art.astro';

interface Props { id?: string; text: string; tag?: 'h1' | 'h2' }
const { id, text, tag: Tag = 'h2' } = Astro.props;
---
<div class="stitle reveal">
  <Art name="faixa" class="stitle__ribbon" />
  <Tag id={id} class="stitle__text script">{text}</Tag>
</div>

<style>
  .stitle {
    position: relative; width: min(100%, 620px); margin: 0 auto clamp(32px, 6vw, 56px);
    container-type: inline-size;
  }
  .stitle__text {
    position: absolute; inset: 9% 16% 38%;
    display: grid; place-items: center; text-align: center;
    font-size: 9.5cqw; white-space: nowrap;
    padding-top: 1cqw;
  }
</style>
