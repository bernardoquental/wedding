---
/** Formulário de RSVP com os componentes CampoTexto, EscolhaPresenca e Botao do design system. */
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).rsvp;
const messages = {
  fullNameError: d.fullNameError,
  fullNameHint: d.fullNameHint,
  contactError: d.contactError,
  contactHint: d.contactHint,
  guestError: d.guestError,
  sending: d.sending,
  submit: d.submit,
  successYes: d.successYes,
  successNo: d.successNo,
  error: d.error,
  demo: d.demo,
  guestName: d.guestName,
};
---
<form class="rsvp-form narrow" novalidate data-messages={JSON.stringify(messages)}>
  <label class="lb-campo" data-field="fullName">
    <span class="lb-campo__rotulo">{d.fullName}</span>
    <input class="lb-campo__input" name="fullName" autocomplete="name" required aria-describedby="ajuda-nome" />
    <span id="ajuda-nome" class="lb-campo__ajuda">{d.fullNameHint}</span>
  </label>

  <div class="rsvp-form__par">
    <label class="lb-campo" data-field="email">
      <span class="lb-campo__rotulo">{d.email}</span>
      <input class="lb-campo__input" type="email" name="email" autocomplete="email" aria-describedby="ajuda-contato" />
    </label>
    <label class="lb-campo">
      <span class="lb-campo__rotulo">{d.phone}</span>
      <input class="lb-campo__input" type="tel" name="phone" autocomplete="tel" aria-describedby="ajuda-contato" />
    </label>
    <span id="ajuda-contato" class="lb-campo__ajuda rsvp-form__contato" data-field="contact">{d.contactHint}</span>
  </div>

  <fieldset class="lb-escolha">
    <legend>{d.attending}</legend>
    <label class="lb-opcao">
      <input type="radio" name="attending" value="yes" checked />
      <span class="lb-opcao__titulo">{d.yes}</span><span class="lb-opcao__texto">{d.yesText}</span>
    </label>
    <label class="lb-opcao">
      <input type="radio" name="attending" value="no" />
      <span class="lb-opcao__titulo">{d.no}</span><span class="lb-opcao__texto">{d.noText}</span>
    </label>
  </fieldset>

  <div class="rsvp-form__sim">
    <label class="lb-campo">
      <span class="lb-campo__rotulo">{d.guests}</span>
      <select class="lb-campo__input" name="guests">
        {[0, 1, 2, 3, 4].map((n) => <option value={n}>{n}</option>)}
      </select>
    </label>
    <div class="rsvp-form__convidados"></div>
    <label class="lb-campo">
      <span class="lb-campo__rotulo">{d.dietary}</span>
      <input class="lb-campo__input" name="dietary" placeholder={d.dietaryHint} />
    </label>
  </div>

  <label class="lb-campo">
    <span class="lb-campo__rotulo">{d.message}</span>
    <textarea class="lb-campo__input" name="message" rows="4"></textarea>
  </label>

  <!-- Campo isca para robôs de spam: humanos não veem -->
  <label class="visually-hidden" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

  <div class="center">
    <button class="lb-btn lb-btn--primario" type="submit">{d.submit}</button>
  </div>
  <div class="rsvp-form__status" role="status" aria-live="polite"></div>
</form>

<script>
  import { send } from '../lib/api';
  import { isFullName, isEmail, isPhone } from '../lib/validate';

  document.querySelectorAll<HTMLFormElement>('form.rsvp-form').forEach((form) => {
    const m = JSON.parse(form.dataset.messages!);
    const q = <T extends Element = HTMLInputElement>(sel: string) => form.querySelector<T>(sel)!;
    const guestsBox = q<HTMLDivElement>('.rsvp-form__convidados');
    const yesBox = q<HTMLDivElement>('.rsvp-form__sim');
    const status = q<HTMLDivElement>('.rsvp-form__status');
    const button = q<HTMLButtonElement>('button[type=submit]');

    const renderGuests = () => {
      const n = Number(q<HTMLSelectElement>('[name=guests]').value);
      const current = [...guestsBox.querySelectorAll('input')].map((i) => i.value);
      guestsBox.innerHTML = '';
      for (let i = 0; i < n; i++) {
        const label = document.createElement('label');
        label.className = 'lb-campo';
        label.innerHTML =
          `<span class="lb-campo__rotulo"></span><input class="lb-campo__input" name="guest${i}" autocomplete="off" />` +
          `<span class="lb-campo__ajuda" hidden></span>`;
        label.querySelector('.lb-campo__rotulo')!.textContent = `${m.guestName} ${i + 1}`;
        label.querySelector('input')!.value = current[i] ?? '';
        guestsBox.append(label);
      }
    };
    q('[name=guests]').addEventListener('change', renderGuests);
    form.querySelectorAll('[name=attending]').forEach((r) =>
      r.addEventListener('change', () => {
        yesBox.hidden = q('[name=attending]:checked').value !== 'yes';
      }),
    );

    /** Estado de erro do CampoTexto: borda tijolo + mensagem na ajuda. */
    const setError = (field: HTMLElement, help: HTMLElement, inputs: HTMLElement[], msg: string | null, hint = '') => {
      field.classList.toggle('lb-campo--erro', !!msg);
      help.classList.toggle('erro', !!msg);
      help.hidden = !msg && !hint;
      help.textContent = msg ?? hint;
      inputs.forEach((i) => i.setAttribute('aria-invalid', msg ? 'true' : 'false'));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '').trim();
      const attending = get('attending');
      const guests = attending === 'yes' ? Number(get('guests')) : 0;
      const guestNames = Array.from({ length: guests }, (_, i) => get(`guest${i}`));

      const nameOk = isFullName(get('fullName'));
      setError(q<HTMLElement>('[data-field=fullName]'), q<HTMLElement>('#ajuda-nome'), [q('[name=fullName]')],
        nameOk ? null : m.fullNameError, m.fullNameHint);
      const contactOk = isEmail(get('email')) || isPhone(get('phone'));
      const contactHelp = q<HTMLElement>('#ajuda-contato');
      setError(q<HTMLElement>('.rsvp-form__par'), contactHelp, [q('[name=email]'), q('[name=phone]')],
        contactOk ? null : m.contactError, m.contactHint);
      form.querySelectorAll<HTMLElement>('.rsvp-form__par .lb-campo').forEach((f) => f.classList.toggle('lb-campo--erro', !contactOk));
      let valid = nameOk && contactOk;
      guestNames.forEach((g, i) => {
        const input = q(`[name=guest${i}]`);
        const field = input.closest<HTMLElement>('.lb-campo')!;
        const ok = isFullName(g);
        setError(field, field.querySelector<HTMLElement>('.lb-campo__ajuda')!, [input], ok ? null : m.guestError);
        valid &&= ok;
      });
      if (!valid) {
        form.querySelector<HTMLElement>('[aria-invalid=true]')?.focus();
        return;
      }

      button.disabled = true;
      button.textContent = m.sending;
      try {
        const res = await send('rsvp', {
          fullName: get('fullName'),
          email: get('email'),
          phone: get('phone'),
          attending,
          guests,
          guestNames,
          dietary: get('dietary'),
          message: get('message'),
          website: get('website'),
        });
        if (!res.ok) throw new Error(res.error);
        form.querySelectorAll<HTMLElement>(':scope > :not(.rsvp-form__status)').forEach((n) => (n.hidden = true));
        const ok = document.createElement('p');
        ok.className = 'aviso';
        ok.textContent = attending === 'yes' ? m.successYes : m.successNo;
        status.replaceChildren(ok);
        if (res.demo) {
          const demo = document.createElement('p');
          demo.className = 'aviso aviso--suave';
          demo.textContent = m.demo;
          status.append(demo);
        }
        status.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch (err) {
        console.error(err);
        const p = document.createElement('p');
        p.className = 'erro center';
        p.textContent = m.error;
        status.replaceChildren(p);
        button.disabled = false;
        button.textContent = m.submit;
      }
    });
  });
</script>

<style>
  .rsvp-form { display: grid; gap: var(--spacing-xl); }
  .rsvp-form__par { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-xsm) var(--spacing-l); }
  .rsvp-form__contato { grid-column: 1 / -1; }
  .rsvp-form__sim, .rsvp-form__convidados { display: grid; gap: var(--spacing-xl); }
  .rsvp-form__convidados:empty { display: none; }
  .rsvp-form__status { display: grid; gap: var(--spacing-m); }
  .rsvp-form :global(select.lb-campo__input) { appearance: auto; }
  @media (max-width: 600px) { .rsvp-form__par { grid-template-columns: 1fr; } }
</style>
